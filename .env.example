# From https://developers.tiktok.com -> your app -> Login Kit (Web)
TIKTOK_CLIENT_KEY=
TIKTOK_CLIENT_SECRET=
# Must match a redirect URI registered on your TikTok app (HTTPS — use a tunnel or a deployed URL)
TIKTOK_REDIRECT_URI=https://your-tunnel.example.com/api/auth/callback

# Random string, 32+ chars. Generate with: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
SESSION_SECRET=

# Timezone used for "best time to post" (IANA name). Defaults to the server's timezone.
TIMEZONE=Europe/Paris
